# ==============================================================================
# MULTI-VENDOR ONLINE GROCERY MARKETPLACE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and fill in the values from your Supabase Dashboard:
# Project Settings -> API (URL & anon key) and Project Settings -> API (service_role key)
#
# NEVER commit your real .env.local file to Git or expose the service role key!
# ==============================================================================

# Supabase Public API URL (Accessible from browser and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous Key (Safe for browser usage, governed by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Server-Only Service Role Key (NEVER expose to client browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default Platform Currency
NEXT_PUBLIC_DEFAULT_CURRENCY=USD
